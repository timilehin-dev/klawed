---
/**
 * The single dynamic top-level route: /<slug>.
 *
 * It serves BOTH a category desk (/jobs, /ai-credits) and a region desk
 * (/nigeria, /africa, /global). A category is one CATEGORIES row plus an enum
 * value (docs/EXTENSIBILITY.md) and a region is one of three fixed values, so
 * neither needs its own page file.
 *
 * It cannot be two files: `[category].astro` and `[region].astro` are both
 * single-segment dynamic routes in SSR mode, and Astro cannot disambiguate
 * /nigeria between them — it warns on the build today and hard-errors later.
 *
 * Same wire composition either way: a two-tone desk masthead, entries filed
 * under date headers, and the archive strip. Under `output: 'server'` the slug is
 * validated at request time and an unknown one rewrites to /404.
 */
import Base from '../layouts/Base.astro';
import EntryRow from '../components/EntryRow.astro';
import DayHeader from '../components/DayHeader.astro';
import EmptyState from '../components/EmptyState.astro';
import RefreshState from '../components/RefreshState.astro';
import ArchiveStrip from '../components/ArchiveStrip.astro';
import { loadCategory, loadRegion, loadCounts } from '../lib/listings';
import { CATEGORIES, REGIONS, isRegion } from '../lib/category-map';
import { formatLongDate, dayKey } from '../lib/format';

const { category: slug } = Astro.params;

/** Which kind of desk this slug names — or neither, for a 404. */
const def = CATEGORIES.find((c) => c.kebab === slug) ?? null;
const regionDesk = slug !== undefined && isRegion(slug);

if (!def && !regionDesk) {
  return Astro.rewrite('/404');
}

/* One instant for the whole render. */
const now = new Date();
const board = regionDesk ? await loadRegion(slug!, now) : await loadCategory(def!.kebab, now);

// The chip bar is global chrome and must describe the WHOLE board on every page
// — design-language §5.2. Reading these off this page's filtered board is what
// made /jobs read "All 2" and "closing soon 0" against the homepage's 59 and 3.
const boardCounts = await loadCounts(now);

const count = board.total;

/** Region-desk copy. A category desk takes its own from the registry. */
const REGION_COPY: Record<string, { desk: string; note: string; empty: string }> = {
  nigeria: {
    desk: 'Nigeria desk',
    note: 'open to builders in Nigeria, filed first',
    empty:
      'No Nigerian listings are live right now. When one is filed and checks out, it leads this board.',
  },
  africa: {
    desk: 'Africa desk',
    note: 'open across the continent, after Nigeria',
    empty:
      'No Africa-wide listings are live right now. When one is filed and checks out, it appears here.',
  },
  global: {
    desk: 'Global desk',
    note: 'open to anyone, anywhere',
    empty: 'No global listings are live right now. When one is filed and checks out, it appears here.',
  },
};

const deskName = def ? def.label : REGION_COPY[slug!].desk;
const deskNote = def
  ? `/${def.kebab} · the desk, filed by day`
  : `/${slug} · ${REGION_COPY[slug!].note}`;
const emptyTitle = def
  ? `Nothing open on the ${def.label} desk.`
  : `Nothing open on the ${REGION_COPY[slug!].desk.toLowerCase()}.`;
const emptyBody = def
  ? `No ${def.label} listings are live right now. When one is filed and checks out, it appears here with a direct link and a stated deadline.`
  : REGION_COPY[slug!].empty;

/** Region groups, Nigeria-first, each holding its own distinct filing days. */
const regionGroups = (regionDesk ? [slug!] : REGIONS).map((region) => {
  const entries = board.live.filter((l) => l.region === region);
  if (entries.length === 0) return null;
  const days: { date: Date; items: typeof entries }[] = [];
  for (const entry of entries) {
    let day = days.find((d) => dayKey(d.date) === dayKey(entry.createdAt));
    if (!day) {
      day = { date: entry.createdAt, items: [] };
      days.push(day);
    }
    day.items.push(entry);
  }
  return { region, days };
}).filter((g): g is NonNullable<typeof g> => g !== null);
---

<Base
  title={`${deskName} — klawhub`}
  description="Open opportunities for builders, filed by day. Every listing carries a direct link, a real deadline and stated eligibility."
  total={boardCounts.total}
  counts={boardCounts.byCategory}
  closingCount={boardCounts.closingSoon}
  surface={slug}
  now={now}
>
  <div class="wrap">
    <header class="desk">
      <div class="rule" />
      <div class="wire-head">
        <h1 class="section-title wire-title">
          <span class="tone-1">{deskName},</span> <span class="tone-2">{count} open.</span>
        </h1>
        <span class="wire-note">{deskNote} · {formatLongDate(now)}</span>
      </div>
    </header>
  </div>

  {
    board.unreachable ? (
      <div class="wrap">
        <RefreshState
          title="The board is being refreshed."
          body={`The ${deskName} could not reach the database just now. Nothing is filed onto the wire until it comes back — try again in a minute or two.`}
        />
      </div>
    ) : count === 0 ? (
      <div class="wrap">
        <EmptyState title={emptyTitle} body={emptyBody} />
      </div>
    ) : (
      <div class="wrap">
        <section class="sec">
          {
            regionGroups.map((group) => (
              <>
                {group.days.map((day) => (
                  <>
                    <DayHeader date={day.date} region={group.region} />
                    <div class="feed">
                      {day.items.map((l) => (
                        <EntryRow listing={l} now={now} />
                      ))}
                    </div>
                  </>
                ))}
              </>
            ))
          }

          {board.archive.length > 0 && (
            <section class="sec">
              <div class="archive">
                <p class="archive-head">
                  Filed and closed — {board.archive.length} kept in the archive
                </p>
                <ArchiveStrip listings={board.archive} />
              </div>
            </section>
          )}
        </section>
      </div>
    )
  }
</Base>

<style>
  .desk {
    padding-top: var(--space-8);
  }
  .rule {
    height: 2px;
    background: var(--ink);
    margin-bottom: var(--space-6);
  }
  .wire-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--ink);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }
  .wire-title {
    font-size: var(--text-h1);
    letter-spacing: -0.01em;
    line-height: 1.08;
  }
  .wire-note {
    font-size: var(--text-meta);
    color: var(--body);
  }
  .sec {
    padding-top: var(--space-6);
  }
  .archive {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    padding: var(--space-5) var(--space-6);
    margin-top: var(--space-6);
  }
  .archive-head {
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--body);
    margin-bottom: var(--space-3);
  }
  @media (max-width: 640px) {
    .wire-title {
      font-size: var(--text-h2);
    }
  }
</style>
