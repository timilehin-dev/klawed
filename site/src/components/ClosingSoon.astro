---
/**
 * ClosingSoon.astro — the one sanctioned near-black block.
 *
 * Held as a first-class section rather than buried in the feed: everything
 * closing inside seven days, two columns, each item linked to its detail page.
 * The note line states how many are in the block and how many of them were
 * filed this week — both counts are computed here from the real list, never
 * stored or invented. Renders nothing when the list is empty.
 */
import RegionTag from './RegionTag.astro';
import DeadlineBadge from './DeadlineBadge.astro';
import { formatDayMonth, isNew } from '../lib/format';
import { toKebab } from '../lib/category-map';
import type { ListingView } from '../lib/listings';

interface Props {
  listings: ListingView[];
  /** The page's single render instant. */
  now?: Date;
}

const { listings, now = new Date() } = Astro.props;

const filedThisWeek = listings.filter((l) => isNew(l.createdAt, now)).length;
---

{
  listings.length > 0 && (
    <section class="closing" aria-labelledby="closing-title">
      <div class="closing-head">
        {/* h2, not h3: this block sits directly under the masthead h1, and an
            h1 -> h3 jump skips a level (design-language §9). The titles inside
            are h3, matching the main feed's EntryRow. */}
        <h2 class="closing-title" id="closing-title">
          <span class="tone-1 is-on-dark">Closing soon</span> <span class="tone-2 is-on-dark">— under seven days.</span>
        </h2>
        <span class="closing-note tabular">
          {listings.length} open · {filedThisWeek} filed this week
        </span>
      </div>

      <div class="closing-grid">
        {listings.map((listing) => (
          <a class="citem" href={`/listings/${listing.slug}`}>
            <h3 class="citem-t">{listing.title}</h3>
            <p class="citem-m">
              {listing.org} · {toKebab(listing.category)} · {listing.region} · filed{' '}
              {formatDayMonth(listing.createdAt)}
            </p>
            <p class="citem-sum">{listing.summary}</p>
            <div class="citem-b">
              <RegionTag region={listing.region} onDark />
              <DeadlineBadge deadline={listing.deadline} evergreen={listing.evergreen} now={now} />
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .closing {
    background: var(--ink);
    border-radius: var(--radius-card-lg);
    padding: var(--space-6);
    color: var(--white);
    margin-top: var(--space-6);
  }

  .closing-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .closing-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    line-height: 1.2;
  }
  /* Two-tone heading, dark variant: clause 1 white, clause 2 muted on dark. */
  .is-on-dark {
    color: var(--white);
  }
  .tone-2.is-on-dark {
    color: var(--on-dark-meta);
  }

  .closing-note {
    font-size: var(--text-meta);
    color: var(--on-dark-meta);
    white-space: nowrap;
  }

  .closing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-8);
    margin-top: var(--space-2);
  }

  .citem {
    display: block;
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color var(--dur) var(--ease);
  }

  .citem-t {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--white);
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color var(--dur) var(--ease);
  }
  .citem:hover .citem-t {
    color: var(--accent-tint);
  }

  .citem-m {
    font-size: var(--text-meta);
    color: var(--on-dark-meta);
    margin-top: 3px;
  }

  .citem-sum {
    /* --on-dark-body (#d4d4d8, ~13:1 on the ink block). --body (#71717a) is
       only ~4.1:1 here, under the §9 floor; design-language §9 also bars small
       body copy from --body outright. */
    font-size: var(--text-body-sm);
    color: var(--on-dark-body);
    margin-top: var(--space-2);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .citem-b {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: 10px;
  }

  /* The deadline badges sit on a near-black fill: the safe band and the
     rolling outline both go quiet so only the countdown reads. */
  .citem-b :global(.badge-safe) {
    background: rgba(255, 255, 255, 0.1);
    color: var(--on-dark-meta);
  }
  .citem-b :global(.badge-rolling) {
    border-color: var(--body-2);
    color: var(--on-dark-meta);
  }
  .citem-b :global(.badge-today) {
    background: var(--white);
    border-color: var(--white);
    color: var(--ink);
  }

  @media (max-width: 1000px) {
    .closing-grid {
      grid-template-columns: 1fr;
    }
    .closing-head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
