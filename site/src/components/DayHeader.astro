---
/**
 * DayHeader.astro — the rule between filing days.
 *
 * "9 Oct · Thu" on the left, a hairline filling the middle, the region tier on
 * the right. The date is Newsreader with tabular figures so a column of day
 * headers lines up as the eye scans down the feed.
 */
import RegionTag from './RegionTag.astro';
import { formatDayMonth, formatDow } from '../lib/format';

interface Props {
  /** The filing day this header introduces. */
  date: Date;
  /** 'nigeria' | 'africa' | 'global'. */
  region: string;
}

const { date, region } = Astro.props;
---

<div class="dayhead">
  <span class="date tabular">{formatDayMonth(date)}</span>
  <span class="dow">{formatDow(date)}</span>
  <span class="line"></span>
  <span class="regionlabel">
    <RegionTag region={region} />
  </span>
</div>

<style>
  .dayhead {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6) 0 var(--space-4);
  }
  .dayhead:first-of-type {
    padding-top: 0;
  }

  .date {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    color: var(--ink);
    flex: none;
    line-height: 1;
  }

  .dow {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--body);
    flex: none;
  }

  .line {
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  .regionlabel {
    flex: none;
    display: inline-flex;
  }
</style>
