---
/**
 * EntryRow.astro — one dated feed entry (the Variant C row-card).
 *
 * Three columns, in filing order: the filing stamp, the entry itself, and the
 * status side (region tag, deadline badge, the Apply affordance). The whole
 * card is one link to the detail page; the title inside it is the h3.
 */
import RegionTag from './RegionTag.astro';
import DeadlineBadge from './DeadlineBadge.astro';
import NewPill from './NewPill.astro';
import ArrowRight from './icons/ArrowRight.astro';
import { formatDayMonth, formatFilingTime } from '../lib/format';
import { toKebab } from '../lib/category-map';
import type { ListingView } from '../lib/listings';

interface Props {
  listing: ListingView;
  /** The page's single render instant. */
  now?: Date;
}

const { listing, now = new Date() } = Astro.props;
const href = `/listings/${listing.slug}`;
const category = toKebab(listing.category);
---

<a class="entry" href={href} data-created-at={listing.createdAt.toISOString()}>
  <span class="entry-stamp tabular">
    {formatDayMonth(listing.createdAt)}
    <br />
    {formatFilingTime(listing.createdAt)}
  </span>

  <div class="entry-main">
    <h3 class="entry-t">
      {listing.title}<NewPill createdAt={listing.createdAt} now={now} />
    </h3>
    <p class="entry-m">{listing.org}<span class="sep">·</span>{category}<span class="sep">·</span>filed {formatFilingTime(listing.createdAt)}</p>
    <p class="entry-sum">{listing.summary}</p>
  </div>

  <div class="entry-side">
    <RegionTag region={listing.region} />
    <DeadlineBadge deadline={listing.deadline} evergreen={listing.evergreen} now={now} />
    <span class="apply">
      Apply
      <ArrowRight />
    </span>
  </div>
</a>

<style>
  .entry {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: var(--space-5);
    align-items: start;
    background: var(--base);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    padding: 18px 22px;
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .entry:hover {
    transform: translateY(-2px);
    border-color: var(--ink-2);
  }

  /* "Just filed" shimmer — a one-shot ~600ms light pass along the left accent edge */
  .entry-shimmer {
    position: relative;
    overflow: hidden;
  }
  .entry-shimmer::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    animation: shimmer-sweep 600ms var(--ease) both;
  }
  @keyframes shimmer-sweep {
    from {
      opacity: 0;
      transform: scaleY(0);
    }
    30% {
      opacity: 1;
      transform: scaleY(1);
    }
    to {
      opacity: 0;
      transform: scaleY(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .entry-shimmer::before {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* ---- the filing stamp ---- */
  .entry-stamp {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    color: var(--body);
    padding-top: 3px;
    letter-spacing: 0.01em;
    line-height: 1.6;
  }

  /* ---- the entry ---- */
  .entry-t {
    font-family: var(--font-sans);
    font-size: var(--text-card-title);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.28;
    color: var(--ink-2);
  }
  .entry:hover .entry-t {
    color: var(--ink);
  }
  .entry-m {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
    font-size: var(--text-meta);
    color: var(--body);
    margin-top: var(--space-1);
  }
  .sep {
    color: var(--hairline);
  }
  .entry-sum {
    font-size: var(--text-body-sm);
    color: var(--body-2);
    margin-top: 7px;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ---- the status side ---- */
  .entry-side {
    min-width: 190px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
    text-align: right;
  }
  .apply {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-meta);
    font-weight: 600;
    color: var(--accent);
    transition:
      gap var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .entry:hover .apply {
    gap: 10px;
    color: var(--accent-strong);
  }

  @media (max-width: 720px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      padding: var(--space-4);
    }
    .entry-stamp {
      padding-top: 0;
    }
    .entry-side {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
