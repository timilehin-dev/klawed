# klawed (klawhub.xyz) — site environment
#
# Copy to C:\Users\HP\klaw\.env (NOT here — this file is the only env file in
# git, and it must hold NO real values). The real secrets live in the workspace
# .env, which is gitignored.
#
# Vercel injects the Postgres values automatically when the Neon/Vercel Postgres
# store is connected to the project.

# --- Datastore: Vercel Postgres (Neon) ---
# Pooled connection — Prisma uses this at runtime.
POSTGRES_PRISMA_URL=
# Unpooled/direct connection — Prisma uses this for migrations.
# Neon's pooled endpoint is PgBouncer and cannot run `migrate deploy`, so
# directUrl is required, not optional.
POSTGRES_URL_NON_POOLING=
# Base URL (some integrations provide it; not read by Prisma directly).
POSTGRES_URL=

# --- Content API (the poster bot calls this) ---
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set in Vercel (Production + Preview) and in the poster profile's .env.
# NEVER commit it. It authenticates POST /api/listings and nothing else.
KLAWHUB_API_KEY=

# --- Site ---
# Public origin, used for canonical URLs and the sitemap.
KLAWHUB_SITE_URL=https://klawhub.xyz
