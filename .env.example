# klawhub Environment Variables
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Nous Portal (inference) ---
NOUS_API_KEY=

# --- Content API (poster bot calls this; builder sets it on the site) ---
KLAWHUB_SITE_URL=
KLAWHUB_API_KEY=

# --- Datastore: Vercel Postgres (Neon) ---
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Vercel (builder deploys) ---
VERCEL_TOKEN=
